<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FIFO_Inventory_Management_System.Views.BranchSelectionPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#121214">

    <Grid>
        <Border StrokeShape="RoundRectangle 12"
                BackgroundColor="#1E1E24"
                Stroke="#33333A"
                Padding="32"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                MaximumWidthRequest="440">
            <VerticalStackLayout Spacing="18">

                <Label Text="OptiStock"
                       FontSize="26"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#F5F5F5"/>
                <Label Text="Choose which branch to open first. Each branch has its own inventory database."
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="#A0A0A8"
                       HorizontalTextAlignment="Center"/>

                <BoxView HeightRequest="1"
                         Color="#33333A"
                         Margin="0,8"/>

                <Label Text="Branch"
                       FontAttributes="Bold"
                       TextColor="#C8C8D0"
                       FontSize="13"/>

                <Border Stroke="#44444C"
                        StrokeShape="RoundRectangle 8"
                        BackgroundColor="#2A2A32"
                        Padding="10,4">
                    <Picker x:Name="BranchPicker"
                            Title="Choose branch…"
                            TextColor="#F0F0F0"
                            TitleColor="#888890"
                            VerticalOptions="Center"/>
                </Border>

                <Button Text="Continue to dashboard"
                        Clicked="OnEnterSystemClicked"
                        BackgroundColor="#2563EB"
                        TextColor="White"
                        FontAttributes="Bold"
                        HeightRequest="48"
                        CornerRadius="8"
                        Margin="0,12,0,0"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
