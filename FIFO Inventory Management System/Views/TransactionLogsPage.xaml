<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FIFO_Inventory_Management_System.Views.TransactionLogsPage"
             Title="System Logs">

    <Grid RowDefinitions="Auto, *">

        <Grid Grid.Row="0" ColumnDefinitions="*, *, *, Auto" Padding="30,20,30,10" ColumnSpacing="15">
            <Button x:Name="TabPoBtn" Text="Incoming (POs)" Clicked="OnTabClicked" CommandParameter="PO" BackgroundColor="#005A9E" TextColor="White" CornerRadius="8"/>
            <Button x:Name="TabRisBtn" Text="Outgoing (RIS)" Clicked="OnTabClicked" CommandParameter="RIS" BackgroundColor="LightGray" TextColor="Black" CornerRadius="8" Grid.Column="1"/>
            <Button x:Name="TabAuditBtn" Text="Audit trail" Clicked="OnTabClicked" CommandParameter="AUDIT" BackgroundColor="LightGray" TextColor="Black" CornerRadius="8" Grid.Column="2"/>

            <HorizontalStackLayout Grid.Column="3" Spacing="15" HorizontalOptions="End">
                <VerticalStackLayout>
                    <Label Text="Sort By Date" FontSize="11" TextColor="Gray"/>
                    <Picker x:Name="SortPicker" WidthRequest="130" SelectedIndexChanged="OnFilterChanged">
                        <Picker.Items>
                            <x:String>Newest First</x:String>
                            <x:String>Oldest First</x:String>
                        </Picker.Items>
                    </Picker>
                </VerticalStackLayout>

                <VerticalStackLayout>
                    <Label x:Name="FilterLabel" Text="Filter Supplier" FontSize="11" TextColor="Gray"/>
                    <Picker x:Name="EntityPicker" WidthRequest="150" SelectedIndexChanged="OnFilterChanged"/>
                </VerticalStackLayout>
            </HorizontalStackLayout>
        </Grid>

        <CollectionView x:Name="LogsList" Grid.Row="1" Margin="30,10,30,30">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="0" Margin="0,10" BorderColor="Gray" HasShadow="True" CornerRadius="8" BackgroundColor="#1f1f1f">
                        <VerticalStackLayout>

                            <Grid ColumnDefinitions="*, 2*, *, Auto" Padding="20" BackgroundColor="Transparent">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnRowTapped" CommandParameter="{Binding .}"/>
                                </Grid.GestureRecognizers>

                                <Label Grid.Column="0" Text="{Binding Document_Number}" FontAttributes="Bold" TextColor="White" VerticalOptions="Center"/>
                                <Label Grid.Column="1" Text="{Binding Entity_Name}" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center"/>
                                <Label Grid.Column="2" Text="{Binding Date}" TextColor="LightGray" VerticalOptions="Center" HorizontalOptions="End"/>
                                <Label Grid.Column="3" Text="▼ Expand" FontSize="12" TextColor="#005A9E" VerticalOptions="Center" Margin="20,0,0,0"/>
                            </Grid>

                            <StackLayout IsVisible="{Binding IsExpanded}" BackgroundColor="Black" Padding="20">

                                <Grid ColumnDefinitions="1.5*, 2*, 0.8*, 1.5*, 1.5*" Margin="0,0,0,10">
                                    <Label Grid.Column="0" Text="Code" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="1" Text="Item Name" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="2" Text="Qty" FontSize="11" TextColor="Gray" HorizontalTextAlignment="Center"/>
                                    <Label Grid.Column="3" Text="Price/pc" FontSize="11" TextColor="Gray"/>
                                    <Label Grid.Column="4" Text="Totals" FontSize="11" TextColor="Gray" HorizontalTextAlignment="End"/>
                                </Grid>

                                <BoxView HeightRequest="1" Color="#333333" Margin="0,0,0,10"/>

                                <CollectionView ItemsSource="{Binding Details}">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="1.5*, 2*, 0.8*, 1.5*, 1.5*" Margin="0,5">
                                                <Label Grid.Column="0" Text="{Binding Item_Code}" FontSize="12" TextColor="DarkGray"/>
                                                <Label Grid.Column="1" Text="{Binding Name}" FontSize="13" FontAttributes="Bold" TextColor="White"/>
                                                <Label Grid.Column="2" Text="{Binding Quantity}" FontSize="13" TextColor="#D9534F" FontAttributes="Bold" HorizontalTextAlignment="Center"/>

                                                <Label Grid.Column="3" Text="{Binding BreakdownText}" FontSize="12" TextColor="White"/>

                                                <VerticalStackLayout Grid.Column="4" HorizontalOptions="End">
                                                    <Label Text="{Binding FormattedRowPrice}" FontSize="13" TextColor="ForestGreen" HorizontalTextAlignment="End"/>
                                                    <Label Text="{Binding FormattedRowRetailPrice}" FontSize="13" FontAttributes="Bold" TextColor="#005A9E" HorizontalTextAlignment="End" IsVisible="{Binding HasRetailPrice}"/>
                                                    <Label Text="{Binding FormattedRowProfit}" FontSize="13" FontAttributes="Bold" TextColor="#FFC107" HorizontalTextAlignment="End" IsVisible="{Binding HasRetailPrice}"/>
                                                </VerticalStackLayout>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Label Text="{Binding SupplierTotalsText}" FontSize="12" TextColor="DimGray" Margin="0,15,0,0" IsVisible="{Binding HasSupplierTotals}"/>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0" IsVisible="{Binding HasSupplierTotals}">
                                    <Label Grid.Column="0" Text="RIS COST TOTAL:" FontAttributes="Bold" TextColor="DimGray" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" Text="{Binding FormattedDocumentTotal}" FontAttributes="Bold" TextColor="#218838" FontSize="13" WidthRequest="150" HorizontalTextAlignment="Start"/>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0" IsVisible="{Binding ShowRisProfit}">
                                    <Label Grid.Column="0" Text="RIS RETAIL TOTAL:" FontAttributes="Bold" TextColor="DimGray" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" Text="{Binding FormattedDocumentRetailTotal}" FontAttributes="Bold" TextColor="#005A9E" FontSize="13" WidthRequest="150" HorizontalTextAlignment="Start"/>
                                </Grid>
                                <Grid ColumnDefinitions="*, Auto" Margin="0,5,0,0" IsVisible="{Binding ShowRisProfit}">
                                    <Label Grid.Column="0" Text="RIS PROFIT:" FontAttributes="Bold" TextColor="DimGray" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0"/>
                                    <Label Grid.Column="1" Text="{Binding FormattedDocumentProfit}" FontAttributes="Bold" TextColor="#FFC107" FontSize="13" WidthRequest="150" HorizontalTextAlignment="Start"/>
                                </Grid>

                                <VerticalStackLayout Margin="0,15,0,0" IsVisible="{Binding IsPOType}" Spacing="5">
                                    <BoxView HeightRequest="1" Color="DarkGray" Margin="0,0,0,5" HorizontalOptions="End" WidthRequest="300"/>
                                    <Label Text="{Binding FormattedDocumentPurchaseTotal}" FontAttributes="Bold" TextColor="ForestGreen" FontSize="14" HorizontalOptions="End"/>
                                    <Label Text="{Binding FormattedDocumentRetailTotal}" FontAttributes="Bold" TextColor="#005A9E" FontSize="14" HorizontalOptions="End"/>
                                    <Label Text="{Binding FormattedDocumentProfit}" FontAttributes="Bold" TextColor="#FFC107" FontSize="14" HorizontalOptions="End" IsVisible="{Binding HasDocumentProfit}"/>
                                </VerticalStackLayout>

                            </StackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView x:Name="AuditList" Grid.Row="1" Margin="30,10,30,30" IsVisible="False">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="1.4*,0.8*,0.8*,1.2*,2*" Padding="12,8">
                        <Label Text="{Binding Timestamp}" TextColor="LightGray"/>
                        <Label Grid.Column="1" Text="{Binding Username}" FontAttributes="Bold"/>
                        <Label Grid.Column="2" Text="{Binding Role}" TextColor="Gray"/>
                        <Label Grid.Column="3" Text="{Binding Action}" TextColor="#2563EB"/>
                        <Label Grid.Column="4" Text="{Binding Details}" TextColor="White"/>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>