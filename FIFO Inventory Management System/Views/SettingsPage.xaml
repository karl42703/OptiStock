<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FIFO_Inventory_Management_System.Views.SettingsPage"
             Title="System Settings">

    <!-- MASTER GRID: Holds the Page and the Overlay -->
    <Grid>


       
        <!-- ========================================== -->
        <!-- LAYER 1: YOUR EXISTING PAGE CONTENT        -->
        <!-- ========================================== -->
        <Grid RowDefinitions="Auto, *, Auto">

            <!-- Row 0: Tab Buttons -->
            <HorizontalStackLayout Grid.Row="0" BackgroundColor="#1E1E24" Padding="20" Spacing="10">
                <Button x:Name="BranchesTabButton" Text="Branches" Clicked="OnBranchesClicked" BackgroundColor="Transparent" TextColor="White"/>
                <Button x:Name="UsersTabButton" Text="User Accounts" Clicked="OnUsersClicked" BackgroundColor="Transparent" TextColor="White"/>
                <Button x:Name="DataManagementTabButton" Text="Data Management" Clicked="OnDataManagementClicked" BackgroundColor="Transparent" TextColor="White"/>
            </HorizontalStackLayout>

            <!-- Row 1: Content ScrollView -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="20" Spacing="20">
                    
                    <!--Branches-->
                    <VerticalStackLayout x:Name="BranchesTabContent" IsVisible="True">
                        <Label Text="Branches" FontSize="18" FontAttributes="Bold" TextColor="White" />
                        <Frame x:Name="BranchSection" BackgroundColor="#1E1E24" Padding="20" CornerRadius="10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Add Branch" TextColor="#2563EB" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="Creates a new empty inventory database. After login, if any branches exist, users pick which branch to open first." TextColor="DimGray" FontSize="13"/>
                                <HorizontalStackLayout Spacing="10">
                                    <Entry x:Name="NewBranchEntry" Placeholder="Branch name" WidthRequest="260"/>
                                    <Button Text="Add Branch" Clicked="OnAddBranchClicked" BackgroundColor="#2563EB" TextColor="White"/>
                                </HorizontalStackLayout>
                                <CollectionView x:Name="BranchList" HeightRequest="180">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*, Auto, Auto" Padding="5">
                                                <Label Text="{Binding .}" VerticalOptions="Center" TextColor="White" FontSize="14" />
                                                <Button Grid.Column="1" Text="Edit" CommandParameter="{Binding .}" Clicked="OnEditBranchClicked" BackgroundColor="#2563EB" TextColor="White" FontSize="11" Margin="5,0" Padding="10,0" HeightRequest="30"/>
                                                <Button Grid.Column="2" Text="Delete" CommandParameter="{Binding .}" Clicked="OnDeleteBranchClicked" BackgroundColor="#DC3545" TextColor="White" FontSize="11" Padding="10,0" HeightRequest="30"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>
                    
                    <!--UsersTabContent-->
                    <VerticalStackLayout x:Name="UsersTabContent" IsVisible="False">
                        <Label Text="User accounts &amp; roles" FontSize="18" FontAttributes="Bold" TextColor="White" />
                        <Frame x:Name="UsersSection" BackgroundColor="Transparent" Padding="20" CornerRadius="10">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Roles: Admin (all), Manager (stock, reports, branches), Staff (receive/issue), Viewer (reports only)." TextColor="DimGray" FontSize="13"/>
                                <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
                                    <Entry x:Name="NewUsernameEntry" Placeholder="Username"/>
                                    <Entry Grid.Column="1" x:Name="NewPasswordEntry" Placeholder="Password" IsPassword="True"/>
                                    <Entry Grid.Column="2" x:Name="NewDisplayNameEntry" Placeholder="Display name"/>
                                    <Picker Grid.Column="3" x:Name="NewRolePicker" Title="Role"/>
                                </Grid>
                                <HorizontalStackLayout Spacing="10">
                                    <Entry x:Name="NewHomeBranchEntry" Placeholder="Home branch (optional)" WidthRequest="220"/>
                                    <Entry x:Name="NewAllowedBranchesEntry" Placeholder="Allowed branches, comma-separated (blank = all)" WidthRequest="320"/>
                                    <Button Text="Create user" Clicked="OnCreateUserClicked" BackgroundColor="#005A9E" TextColor="White"/>
                                </HorizontalStackLayout>
                                <CollectionView x:Name="UsersList" HeightRequest="140">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,*,Auto,Auto" Padding="6">
                                                <Label Text="{Binding Username}" FontAttributes="Bold"/>
                                                <Label Grid.Column="1" Text="{Binding Role}"/>
                                                <Button Grid.Column="2" Text="Reset pw" Clicked="OnResetPasswordClicked" CommandParameter="{Binding .}" FontSize="11"/>
                                                <Button Grid.Column="3" Text="Disable" Clicked="OnToggleUserClicked" CommandParameter="{Binding .}" FontSize="11"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                    <!--Data Management-->
                    <VerticalStackLayout x:Name="DataManagementLayout" IsVisible="False" BackgroundColor="Transparent">
                        <Label Text="Data Management" FontSize="18" FontAttributes="Bold" TextColor="White" />

                        <!-- BACKUP ZONE -->
                        <Frame BackgroundColor="Transparent" Padding="20"  CornerRadius="10" HasShadow="True">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Database Backup (Current Branch)" TextColor="#217346" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="Export the active branch only into an Excel file for auditing or safekeeping." TextColor="DimGray" FontSize="13"/>
                                <Button x:Name="ExportBtn" Text="Export Current Branch to Excel" BackgroundColor="#217346" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0" Clicked="OnExportDatabaseClicked"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- DEVICE TRANSFER ZONE -->
                        <Frame BackgroundColor="#1a2a1a" Padding="20" CornerRadius="10" HasShadow="True" BorderColor="#217346">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Transfer Between Devices" TextColor="#217346" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="Export or import all branch databases as one portable .zip file. Copy it to another PC running this same system to sync every branch's inventory data." TextColor="DimGray" FontSize="13"/>
                                <Button x:Name="ExportAllBranchesBtn" Text="Export All Branch Databases (.zip)" BackgroundColor="#217346" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0" Clicked="OnExportAllBranchesClicked"/>
                                <Button x:Name="ImportAllBranchesBtn" Text="Import Branch Databases (.zip)" BackgroundColor="#005A9E" TextColor="White" FontAttributes="Bold" CornerRadius="8" Clicked="OnImportAllBranchesClicked"/>
                            </VerticalStackLayout>
                        </Frame>

                        <!-- DANGER ZONE -->
                        <Frame BackgroundColor="#1f1f1f" Padding="20" CornerRadius="10" HasShadow="True">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Danger Zone" TextColor="#DC3545" FontAttributes="Bold" FontSize="16"/>
                                <Label Text="Wiping the database will permanently delete all Purchase Orders, Requisition Slips, Items, and Transaction Logs. This action cannot be undone." TextColor="Gray" FontSize="13"/>
                                <Button Text="Wipe Database (Reset System)" BackgroundColor="#DC3545" TextColor="White" FontAttributes="Bold" CornerRadius="8" Margin="0,10,0,0" Clicked="OnResetDatabaseClicked"/>
                            </VerticalStackLayout>
                        </Frame>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- FOOTER -->
            <VerticalStackLayout Grid.Row="2" Padding="20,10,20,20" BackgroundColor="Transparent" HorizontalOptions="Center">
                <Label Text="© 2026 Developed by Karl Louisse O. Agbayani" FontSize="12" TextColor="Gray" HorizontalTextAlignment="Center"/>
                <Label Text="FIFO Inventory Management System" FontSize="10" TextColor="Silver" Margin="0,2,0,0" HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>

        </Grid>

        <!-- ========================================== -->
        <!-- LAYER 2: THE LOADING OVERLAY (Hidden by default) -->
        <!-- ========================================== -->
        <Grid x:Name="LoadingOverlay" IsVisible="False" BackgroundColor="#A0000000">
            <!-- #A0000000 is a dark transparent gray -->
            <Frame HorizontalOptions="Center" VerticalOptions="Center" Padding="30" CornerRadius="10" BackgroundColor="White" HasShadow="True">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">

                    <!-- The Spinning Wheel -->
                    <ActivityIndicator IsRunning="True" Color="#217346" HorizontalOptions="Center"/>

                    <Label x:Name="LoadingTitleLabel" Text="Working..." FontAttributes="Bold" TextColor="#333333" HorizontalOptions="Center" />
                    <Label x:Name="LoadingLabel" Text="Please wait, do not close the app." FontSize="12" TextColor="Gray" HorizontalOptions="Center" />

                </VerticalStackLayout>
            </Frame>
        </Grid>

    </Grid>
</ContentPage>